HF_TOKEN=your_token_here         # Hugging face token needed to pull gated models like Gemma
MODEL_ID=google/gemma-3-4b-it    # LLM for story generation
VOICE_MODEL_ID=openbmb/VoxCPM2   # TTS model for narration
IMAGE_MODEL_ID=black-forest-labs/FLUX.2-klein-4B  # image generation model
QUANTIZE_4BIT=true               # recommended true for local dev, false on A100
VRAM_SWAP=true                   # true locally, false on HF Spaces/A100
TEXT_DEVICE=cpu/cuda             # cpu for local dev, cuda on GPU
NARRATOR_DEVICE=cpu/cuda         # cpu for local dev, cuda on GPU
IMAGE_DEVICE=cpu/cuda            # cpu for local dev, cuda on GPU
TORCHDYNAMO_DISABLE=1            # required to avoid torch.compile crash in VoxCPM2
